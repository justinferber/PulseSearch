      "text": "Eventim is an authorised ticketing agency in Germany; check that the seller named on the event page matches the checkout before paying.",
      "evidence": [
        "ev-eventim",
        "ev-columbiahalle"
      ]
    },
    {
      "fact_id": "fact-4364f94f7a29",
      "text": "Check the venue page for doors, age limits, accessibility and bag rules, which vary by show.",
      "evidence": [
        "ev-huxleys",
        "ev-verti"
      ]
    },
    {
      "fact_id": "fact-7c25f45f0509",
      "text": "Use the BVG journey planner for U-Bahn, tram and bus connections to the venue.",
      "evidence": [
        "ev-bvg",
        "ev-berlin-en"
      ]
    },
    {
      "fact_id": "fact-02b47ee0fd51",
      "text": "Check S-Bahn service updates before travelling; engineering works can change the last connection.",
      "evidence": [
        "ev-sbahn",
        "ev-bvg"
      ]
    },
    {
      "fact_id": "fact-5e8d528f71e7",
      "text": "Use BBC Weather for city forecasts and the Met Office for the official UK forecast and weather warnings.",
      "evidence": [
        "ev-uk-weather",
        "ev-metoffice"
      ]
    },
    {
      "fact_id": "fact-f5f010165854",
      "text": "Treat a forecast as guidance, not a guarantee; warnings and local conditions can change during the day.",
      "evidence": [
        "ev-metoffice"
      ]
    },
    {
      "fact_id": "fact-b5853c4036ad",
      "text": "Use the DWD for national warnings and forecasts, and the city or state service for local information.",
      "evidence": [
        "ev-dwd",
        "ev-berlin-en"
      ]
    },
    {
      "fact_id": "fact-628b2a367fc2",
      "text": "Look for CSD or Christopher Street Day listings in each city; programmes and dates are published by local organisers.",
      "evidence": [
        "ev-berlin-events",
        "ev-csd-berlin"
      ]
    },
    {
      "fact_id": "fact-cdf187c6322c",
      "text": "Check the organiser's own page for route, accessibility and any changes before travelling.",
      "evidence": [
        "ev-csd-berlin"
      ]
    },
    {
      "fact_id": "fact-db6ae8bf5e93",
      "text": "Check the Mayor of London's official page for the event announcement, viewing areas and ticket arrangements.",
      "evidence": [
        "ev-london-gov",
        "ev-tfl"
      ]
    },
    {
      "fact_id": "fact-fe1adf1c3038",
      "text": "Plan travel with TfL and expect road closures and busy stations on the night.",
      "evidence": [
        "ev-tfl",
        "ev-london-gov"
      ]
    },
    {
      "fact_id": "fact-e6eb0dc5d401",
      "text": "Compare the airline's own site with a licensed agent, and check who the seller is before paying.",
      "evidence": [
        "ev-ba",
        "ev-lufthansa"
      ]
    },
    {
      "fact_id": "fact-7a867c014811",
      "text": "Check ATOL or ABTA protection where it applies, and read the fare rules for changes and refunds.",
      "evidence": [
        "ev-caa",
        "ev-abta"
      ]
    },
    {
      "fact_id": "fact-edf4b314a95b",
      "text": "Check the seller's terms and the official consumer guidance for the country of purchase before disputing a charge.",
      "evidence": [
        "ev-govuk-consumer",
        "ev-caa"
      ]
    },
    {
      "fact_id": "fact-57109a62cbb2",
      "text": "For a cancelled event, contact the original seller; resale sites may not offer the same protection.",
      "evidence": [
        "ev-caa",
        "ev-abta"
      ]
    },
    {
