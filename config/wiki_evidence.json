  "facts": [
    {
      "fact_id": "fact-66996b79a739",
      "text": "Start at the venue's own programme or the Berlin events calendar, then follow the official ticket link shown for that event.",
      "evidence": [
        "ev-berlin-events",
        "ev-mercedes-arena"
      ]
    },
    {
